#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

// =============================================================================
// MOUSE KEY CONFIGURATION
// =============================================================================
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 10

// =============================================================================
// MODIFIER COMBINATIONS - Swap these to change modifier chords
// =============================================================================
#define HYPER LC(LS(LG(LALT)))  // All four modifiers
#define MEH LC(LS(LALT))        // Ctrl+Shift+Alt (no GUI)

// =============================================================================
// MACOS SHORTCUTS
// =============================================================================
#define _UNDO   LG(Z)
#define _REDO   LG(LS(Z))
#define _CUT    LG(X)
#define _COPY   LG(C)
#define _PASTE  LG(V)
#define _SELALL LG(A)

// =============================================================================
// LAYERS - Reorder by changing numbers
// =============================================================================
#define BASE 0
#define CURSOR 1    // hold SPACE - navigation on right hand
#define NUMBER 2    // hold BSPC - numpad on right hand
#define FUNCTION 3  // hold ESC - F-keys, media
#define SYMBOL 4    // hold RETURN - symbols on left hand
#define MOUSE 5     // hold TAB - mouse keys on right hand
#define SYSTEM 6    // hold SYSTEM - RGB, power
#define LOWER 7     // layer access
#define MAGIC 8     // BT, bootloader

// Legacy aliases for compatibility
#define NAV CURSOR
#define SYM SYMBOL

// =============================================================================
// HOME ROW MODS - Swap modifiers by finger position
// Left hand:  pinky -> index (C I E A)
// Right hand: index -> pinky (H T S N)
// =============================================================================
#define HRM_L_PINKY LGUI        // C - Cmd
#define HRM_L_RING  LALT        // I
#define HRM_L_MID   LSHFT       // E
#define HRM_L_INDEX LCTRL       // A

#define HRM_R_INDEX RCTRL       // H
#define HRM_R_MID   RSHFT       // T
#define HRM_R_RING  RALT        // S
#define HRM_R_PINKY RGUI        // N - Cmd

// =============================================================================
// TOP ROW MODS - Above home row, hold for modifier
// Left hand:  pinky -> index (B Y O U)
// Right hand: index -> pinky (L D W V)
// Priority: protect pinkies and ring fingers, put most-used on index
// =============================================================================
#define TOP_L_PINKY NONE        // B - no mod (protect pinky)
#define TOP_L_RING  NONE        // Y - no mod (protect ring)
#define TOP_L_MID   MEH         // O - Meh (Ctrl+Shift+Alt) - less common
#define TOP_L_INDEX HYPER       // U - Hyper (Ctrl+Shift+Alt+Cmd) - most common

#define TOP_R_INDEX HYPER       // L - Hyper (Ctrl+Shift+Alt+Cmd) - most common
#define TOP_R_MID   MEH         // D - Meh (Ctrl+Shift+Alt) - less common
#define TOP_R_RING  NONE        // W - no mod (protect ring)
#define TOP_R_PINKY NONE        // V - no mod (protect pinky)

// =============================================================================
// THUMB CLUSTERS - Keycaps and layer assignments
// Left:  ESC UP DOWN    |  Right: LEFT RIGHT SYS
//        SPC BSP LOWER  |         RAISE TAB RET
// =============================================================================
// Upper arc - tap keys
#define THUMB_UL1_TAP ESC       // Left upper 1 - tap ESC
#define THUMB_UL1_HOLD FUNCTION // Left upper 1 - hold Function
#define THUMB_UL2 UP            // Left upper 2 - plain UP
#define THUMB_UL3 DOWN          // Left upper 3 - plain DOWN
#define THUMB_UR1 LEFT          // Right upper 1 - plain LEFT
#define THUMB_UR2 RIGHT         // Right upper 2 - plain RIGHT
#define THUMB_UR3_TAP ESC       // Right upper 3 - tap ESC
#define THUMB_UR3_HOLD SYSTEM   // Right upper 3 - hold System

// Lower arc - tap keys and layer holds
#define THUMB_LL1_TAP SPACE     // Left lower 1 - tap SPACE
#define THUMB_LL1_HOLD CURSOR   // Left lower 1 - hold Cursor
#define THUMB_LL2_TAP BSPC      // Left lower 2 - tap BSPC
#define THUMB_LL2_HOLD NUMBER   // Left lower 2 - hold Number
#define THUMB_LL3 LOWER         // Left lower 3 - Lower layer access
#define THUMB_LR1 LOWER         // Right lower 1 - Raise (same as Lower)
#define THUMB_LR2_TAP TAB       // Right lower 2 - tap TAB
#define THUMB_LR2_HOLD MOUSE    // Right lower 2 - hold Mouse
#define THUMB_LR3_TAP RET       // Right lower 3 - tap RETURN
#define THUMB_LR3_HOLD SYMBOL   // Right lower 3 - hold Symbol

// =============================================================================
// KEY POSITION INDICES - For positional hold-tap and combos
// Reference: https://github.com/moergo-sc/glove80-zmk-config/blob/main/docs/glove80-key-positions.png
// =============================================================================
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 52 53 54 55 56 57
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 58 59 60 61 62 63
#define THUMBS 64 65 66 67 68 69 70 71 72 73 74 75

// Home row key positions (for combos)
// Left:  C=25, I=26, E=27, A=28
// Right: H=31, T=32, S=33, N=34
#define POS_C 25
#define POS_I 26
#define POS_E 27
#define POS_A 28
#define POS_H 31
#define POS_T 32
#define POS_S 33
#define POS_N 34

// Top row key positions
// Left:  B=13, Y=14, O=15, U=16
// Right: L=19, D=20, W=21, V=22
#define POS_B 13
#define POS_Y 14
#define POS_O 15
#define POS_U 16
#define POS_L 19
#define POS_D 20
#define POS_W 21
#define POS_V 22

// Thumb cluster positions (for combos)
// Upper arc positions from sunaku THUMB_KEYS visual
// Upper arc (inner, closer to alphas): Left 52-54, Right 57,56,55
#define POS_THUMB_UL1 52   // Left upper 1 (ESC/Fn)
#define POS_THUMB_UL2 53   // Left upper 2 (UP)
#define POS_THUMB_UL3 54   // Left upper 3 (DOWN)
#define POS_THUMB_UR1 55   // Right upper 1 (LEFT)
#define POS_THUMB_UR2 56   // Right upper 2 (RIGHT)
#define POS_THUMB_UR3 57   // Right upper 3 (ESC/Sys)
// Lower arc (outer, further from alphas): Left 69-71, Right 72-74
#define POS_THUMB_LL1 69   // Left lower 1 (SPACE)
#define POS_THUMB_LL2 70   // Left lower 2 (BSPC)
#define POS_THUMB_LL3 71   // Left lower 3 (TAB/Nav)
#define POS_THUMB_LR1 72   // Right lower 1 (TAB/Sym)
#define POS_THUMB_LR2 73   // Right lower 2 (TAB)
#define POS_THUMB_LR3 74   // Right lower 3 (ENTER)

// =============================================================================
// TIMING - Base resolution and per-finger adjustments
// Inspired by sunaku's Glorious Engrammer timing research
// =============================================================================
// Base timing - increase if you get accidental holds, decrease for faster response
#define TAPPING_TERM 150

// Per-finger adjustments - slower fingers need more time
// Index fingers are fastest, pinkies are slowest
#define INDEX_TIME  (TAPPING_TERM + 30)   // 180ms - most dexterous
#define MIDDLE_TIME (TAPPING_TERM + 60)   // 210ms
#define RING_TIME   (TAPPING_TERM + 90)   // 240ms
#define PINKY_TIME  (TAPPING_TERM + 120)  // 270ms - least dexterous

// Thumb timing - fast for responsive layer switching
#define THUMB_TIME  TAPPING_TERM          // 150ms

// Streak decay - time after typing before mods can activate
// Prevents accidental mods during fast typing
#define STREAK_DECAY TAPPING_TERM         // 150ms

// Quick-tap - time window for double-tap to repeat
#define QUICK_TAP   (TAPPING_TERM + 150)  // 300ms

// =============================================================================
// COMBO TIMING - Adjust how quickly keys must be pressed together
// =============================================================================
#define COMBO_TIMEOUT 100

/ {
    behaviors {
        // =====================================================================
        // HOME ROW MODS - Per-finger timing with bilateral enforcement
        // Only activates when opposite hand is used (prevents same-hand misfires)
        // =====================================================================

        // Left hand - Index finger (fastest)
        hml_i: hml_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <INDEX_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Left hand - Middle finger
        hml_m: hml_middle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <MIDDLE_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Left hand - Ring finger
        hml_r: hml_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <RING_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Left hand - Pinky finger (slowest)
        hml_p: hml_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <PINKY_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Left hand - Generic (for top row, uses ring timing)
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <RING_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand - Index finger (fastest)
        hmr_i: hmr_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <INDEX_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand - Middle finger
        hmr_m: hmr_middle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <MIDDLE_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand - Ring finger
        hmr_r: hmr_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <RING_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand - Pinky finger (slowest)
        hmr_p: hmr_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <PINKY_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand - Generic (for top row, uses ring timing)
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <RING_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <STREAK_DECAY>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // =====================================================================
        // THUMB KEYS - Layer-tap for quick layer access
        // No bilateral enforcement - layers should work with either hand
        // =====================================================================

        // Left thumb - layer tap
        ltl: layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <THUMB_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&mo>, <&kp>;
        };

        // Right thumb - layer tap
        ltr: layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <THUMB_TIME>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&mo>, <&kp>;
        };

        // =====================================================================
        // SPECIAL BEHAVIORS
        // =====================================================================

        // Magic key: tap for RGB status, hold for Magic layer
        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <THUMB_TIME>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        // Parang: tap = parenthesis, shift+tap = angle bracket
        // "parang" = parenthesis + angle
        parang_left: parang_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        parang_right: parang_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    // CapsWord: types in CAPS until space/punctuation, then auto-disables
    // https://zmk.dev/docs/behaviors/caps-word
    caps_word {
        continue-list = <UNDERSCORE MINUS BSPC DEL>;
    };

    // =========================================================================
    // COMBOS - Thumb-only combos for ergonomics (no lateral finger strain)
    // =========================================================================
    combos {
        compatible = "zmk,combos";

        // ---- App Switching ----
        // ESC + SPACE (left thumb vertical chord) = App switcher
        // Holds Cmd, taps Tab, activates NAV layer for arrow navigation
        // Release combo to select app
        combo_app_switch {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <POS_THUMB_UL1 POS_THUMB_LL1>;
            bindings = <&app_switcher>;
        };

        // ---- Quick Launch ----
        // ESC/Sys + ENTER (right thumb vertical chord) = Launchbar (Meh+L)
        combo_launchbar {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <POS_THUMB_UR3 POS_THUMB_LR3>;
            bindings = <&launchbar>;
        };

        // TAB + ENTER (right thumb lower) = Screenshot (Cmd+Shift+4)
        combo_screenshot {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <POS_THUMB_LR2 POS_THUMB_LR3>;
            bindings = <&screenshot>;
        };
    };

    macros {
        // Hyper+Space macro for Raycast/Alfred
        hyper_space: hyper_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LG(LA(SPACE))))>;
        };

        // Launchbar: Meh+L (Ctrl+Shift+Alt+L)
        launchbar: launchbar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LA(L)))>;
        };

        // Screenshot: Cmd+Shift+4
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N4))>;
        };

        // App switcher: Hold Cmd, tap Tab, activate NAV layer for arrows
        // Release combo to select app and release Cmd
        // Inspired by sunaku's mod_tab_chord
        app_switcher: app_switcher {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo NAV>
                , <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>
                , <&macro_release &mo NAV>
                ;
        };

        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // Engrammer layout with home row mods and thumb clusters
            // https://github.com/sunaku/engrammer
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   \  |
            // |  `    |  B  |  Y  |O/Meh |U/Hyp |  '   |                                                 |  ;   |L/Hyp  |D/Meh  |  W   |   V   |   Z  |
            // | CAPS  |C/Cmd|I/Alt|E/Shft|A/Ctrl|  ,   |                                                 |  .   |H/Ctrl|T/Shft |S/Alt |N/Cmd  |   Q  |
            // |   `   |  G  |  X  |  J   |  K   |  -   |  ESC  |  UP   | DOWN  | | LEFT  | RIGHT |  ESC  |  /   |   R   |   M   |  F   |   P   | SHIFT|
            // | MAGIC | HOME| PGUP| PGDN | END  |      | SPACE | BSPC  |NAV/TAB| |SYM/TAB|  TAB  | ENTER |      |  (/\< |   [   |  ]   |  )/\> | MAGIC|

            bindings = <
            &kp F1         &kp F2            &kp F3            &kp F4            &kp F5                                                                                                              &kp F6    &kp F7            &kp F8            &kp F9            &kp F10
            &kp EQUAL      &kp N1            &kp N2            &kp N3            &kp N4            &kp N5                                                                                    &kp N6  &kp N7    &kp N8            &kp N9            &kp N0            &kp BSLH
            &kp GRAVE      &kp B             &kp Y             &hml_m TOP_L_MID O &hml_i TOP_L_INDEX U &kp SQT                                                                              &kp SEMI &hmr_i TOP_R_INDEX L &hmr_m TOP_R_MID D &kp W              &kp V              &kp Z
            &caps_word     &hml_p HRM_L_PINKY C &hml_r HRM_L_RING I &hml_m HRM_L_MID E &hml_i HRM_L_INDEX A &kp COMMA                                                                            &kp DOT  &hmr_i HRM_R_INDEX H &hmr_m HRM_R_MID T &hmr_r HRM_R_RING S &hmr_p HRM_R_PINKY N &kp Q
            &kp GRAVE      &kp G             &kp X             &kp J             &kp K             &kp MINUS &ltl THUMB_UL1_HOLD THUMB_UL1_TAP &kp THUMB_UL2 &kp THUMB_UL3 &kp THUMB_UR1 &kp THUMB_UR2 &ltr THUMB_UR3_HOLD THUMB_UR3_TAP &kp FSLH &kp R    &kp M             &kp F             &kp P             &kp RSHFT
            &magic MAGIC 0 &kp HOME          &kp PG_UP         &kp PG_DN         &kp END                     &ltl THUMB_LL1_HOLD THUMB_LL1_TAP &ltl THUMB_LL2_HOLD THUMB_LL2_TAP &mo THUMB_LL3 &mo THUMB_LR1 &ltr THUMB_LR2_HOLD THUMB_LR2_TAP &ltr THUMB_LR3_HOLD THUMB_LR3_TAP       &parang_left &kp LBKT       &kp RBKT          &parang_right     &magic MAGIC 0
            >;
        };

        // Layer 1: CURSOR - hold SPACE - navigation on RIGHT hand
        // Vim-style: arrows on home row (LEFT, UP, DOWN, RIGHT on H, T, S, N positions)
        // Left hand: editing shortcuts (undo/redo/cut/copy/paste)
        cursor_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &kp ESC        &kp RET        &kp SPACE      &kp TAB        &kp DEL        &kp INS                                                                            &kp INS    &kp DEL      &kp TAB      &kp SPACE    &kp RET      &kp ESC
            &none          &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &kp _CUT                                                                           &kp _CUT   &kp BSPC     &kp _UNDO    &kp _REDO    &sk RSHFT    &none
            &none          &kp LGUI       &kp LALT       &kp LSHFT      &kp LCTRL      &kp _COPY                                                                          &kp _COPY  &kp LEFT     &kp UP       &kp DOWN     &kp RIGHT    &none
            &none          &kp _SELALL    &none          &none          &none          &kp _PASTE &trans     &trans     &to BASE   &none      &none      &none            &kp _PASTE &kp HOME     &kp PG_UP    &kp PG_DN    &kp END      &none
            &trans         &none          &none          &none          &none                     &trans     &trans     &trans     &kp _SELALL &none     &none                        &none        &none        &none        &none        &trans
            >;
        };

        // Layer 2: NUMBER - hold BSPC - numpad on RIGHT hand
        // Left hand: hex digits A-F, editing
        // Right hand: numpad with operators
        number_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &kp ESC        &kp RET        &kp SPACE      &kp TAB        &kp DEL        &kp INS                                                                            &kp TILDE  &kp CARET    &kp HASH     &kp DLLR     &kp EXCL     &kp PIPE
            &kp A          &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &kp D                                                                              &kp LS(G)  &kp N7       &kp N8       &kp N9       &kp COLON    &kp PRCNT
            &kp B          &kp LGUI       &kp LALT       &kp LSHFT      &kp LCTRL      &kp E                                                                              &kp K      &kp N4       &kp N5       &kp N6       &kp MINUS    &kp PLUS
            &kp C          &kp _SELALL    &none          &none          &kp X          &kp F      &trans     &trans     &to BASE   &kp LBKT   &kp RBKT   &kp EQUAL        &kp J      &kp N1       &kp N2       &kp N3       &kp FSLH     &kp ASTRK
            &trans         &none          &none          &none          &kp UNDER                 &trans     &trans     &trans     &kp COMMA  &kp DOT    &kp N0                       &kp LT       &kp LPAR     &kp RPAR     &kp GT       &kp AT
            >;
        };

        // Layer 3: FUNCTION - hold ESC - F-keys, media
        // Left hand: editing with modifiers
        // Right hand: F-keys (numpad layout) and media controls
        function_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &kp ESC        &kp RET        &kp SPACE      &kp TAB        &kp DEL        &kp INS                                                                            &kp C_MEDIA_HOME &kp C_PLAY &kp C_PREV &kp C_NEXT   &kp C_STOP   &kp C_EJECT
            &none          &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &none                                                                              &kp K_CALC &kp F7       &kp F8       &kp F9       &kp F10      &kp F13
            &none          &kp LGUI       &kp LALT       &kp LSHFT      &kp LCTRL      &none                                                                              &kp K_WWW  &kp F4       &kp F5       &kp F6       &kp F11      &kp F14
            &none          &kp _SELALL    &none          &none          &none          &none      &trans     &trans     &to BASE   &kp C_PREV &kp C_NEXT &kp C_PP         &none      &kp F1       &kp F2       &kp F3       &kp F12      &kp F15
            &trans         &none          &none          &none          &none                     &trans     &trans     &trans     &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP                &kp C_BRI_MAX &kp C_BRI_UP &kp C_BRI_DN &kp C_BRI_MIN &kp C_BRI_AUTO
            >;
        };

        // Layer 4: SYMBOL - hold RETURN - symbols on LEFT hand
        // Left hand: programming symbols in logical groups
        // Right hand: modifiers for chording
        symbol_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &none          &kp GRAVE      &kp LPAR       &kp RPAR       &kp SEMI       &kp COMMA                                                                          &none       &none        &none        &none        &none        &none
            &kp EXCL       &kp LBRC       &kp SQT        &kp DQT        &kp RBRC       &kp QMARK                                                                          &kp SEMI    &kp RCTRL    &kp RSHFT    &kp RALT     &kp RGUI     &none
            &kp HASH       &kp CARET      &kp EQUAL      &kp UNDER      &kp DLLR       &kp ASTRK                                                                          &kp DOT     &kp BSPC     &kp TAB      &kp SPACE    &kp RET      &none
            &kp TILDE      &kp LT         &kp PIPE       &kp MINUS      &kp GT         &kp FSLH   &kp BSLH   &kp DOT    &to BASE   &trans     &trans     &trans            &kp FSLH    &kp DEL      &kp LS(TAB)  &none        &none        &none
            &kp AT         &kp AMPS       &kp LBKT       &kp RBKT       &kp PLUS                  &kp PRCNT  &kp COLON  &trans     &trans     &trans     &trans                        &trans       &trans       &trans       &trans       &none
            >;
        };

        // Layer 5: MOUSE - hold TAB - mouse keys on RIGHT hand
        // Left hand: scroll wheel, modifiers for drag operations
        // Right hand: mouse movement and clicks
        mouse_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &none          &none          &none          &none          &none          &none                                                                              &none       &none        &none        &none        &none        &none
            &none          &none          &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &none                                                                             &mkp MCLK   &kp RCTRL    &kp RSHFT    &kp RALT     &kp RGUI     &none
            &none          &kp LGUI       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none                                                                             &mkp LCLK   &mmv MOVE_LEFT &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
            &none          &none          &none          &msc SCRL_DOWN &msc SCRL_UP   &none      &mkp MCLK  &trans     &to BASE   &trans     &trans     &trans            &mkp RCLK   &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_RIGHT &none
            &trans         &none          &none          &none          &none                     &mkp LCLK  &mkp RCLK  &trans     &trans     &trans     &trans                        &none        &none        &none        &none        &none
            >;
        };

        // Layer 6: SYSTEM - hold SYSTEM key - RGB, power, locks
        // Left hand: RGB controls
        // Right hand: system functions, lock, sleep, power
        system_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &none          &none          &none          &none          &none          &none                                                                              &none       &none        &none        &none        &none        &none
            &none          &none          &rgb_ug RGB_HUD &rgb_ug RGB_HUI &none         &kp SLCK                                                                          &rgb_ug RGB_SAI &kp RCTRL  &kp RSHFT    &kp RALT     &kp RGUI     &rgb_ug RGB_SAD
            &rgb_ug RGB_TOG &rgb_ug RGB_EFR &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFF &kp CAPS                                                                      &rgb_ug RGB_HUI &kp K_APP  &kp LG(LC(Q)) &kp C_SLEEP &kp C_POWER  &rgb_ug RGB_HUD
            &none          &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_SPI &kp KP_NUM &kp LG(LC(Q)) &kp C_SLEEP &to BASE &trans   &trans     &trans        &rgb_ug RGB_SPI &rgb_ug RGB_TOG &kp PSCRN &kp SLCK   &kp PAUSE_BREAK &rgb_ug RGB_SPD
            &trans         &none          &none          &none          &none                     &kp PSCRN  &kp K_APP  &trans     &trans     &trans     &trans                        &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFR &none
            >;
        };

        // Layer 7: LOWER - layer access, toggles, sticky mods
        // Access other layers by toggle or momentary hold
        lower_layer {
            bindings = <
            &none          &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &none
            &none          &none          &none          &none          &none          &none                                                                              &none       &none        &none        &none        &none        &none
            &none          &none          &tog CURSOR    &tog NUMBER    &tog FUNCTION  &none                                                                              &none       &tog FUNCTION &tog NUMBER &tog CURSOR  &none        &none
            &none          &sk LGUI       &sk LALT       &sk LSHFT      &sk LCTRL      &none                                                                              &none       &sk RCTRL    &sk RSHFT    &sk RALT     &sk RGUI     &none
            &none          &none          &tog SYMBOL    &tog MOUSE     &tog SYSTEM    &none      &trans     &trans     &to BASE   &trans     &trans     &trans            &none       &tog SYSTEM  &tog MOUSE   &tog SYMBOL  &none        &none
            &trans         &none          &none          &none          &none                     &trans     &trans     &trans     &trans     &trans     &trans                        &none        &none        &none        &none        &trans
            >;
        };

        // Layer 8: MAGIC - BT profiles, bootloader
        magic_layer {
            bindings = <
            &bt BT_CLR     &none          &none          &none          &none                                                                                                         &none        &none        &none        &none        &bt BT_CLR_ALL
            &none          &none          &none          &none          &none          &none                                                                              &none       &none        &none        &none        &none        &none
            &none          &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                 &none       &none        &none        &none        &none        &none
            &bootloader    &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                 &none       &none        &none        &none        &none        &bootloader
            &sys_reset     &none          &none          &none          &none          &none      &bt_2      &bt_3      &none      &none      &none      &none             &none       &none        &none        &none        &none        &sys_reset
            &none          &none          &none          &none          &none                     &bt_0      &bt_1      &out OUT_USB &none    &none      &none                         &none        &none        &none        &none        &none
            >;
        };
    };
};
